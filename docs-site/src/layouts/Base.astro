---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import Hud from "../components/Hud.astro";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
  title: string;
  current: string;
  description?: string;
}
const { title, current, description = "Interactive technical documentation and architecture review for the Predictive-Maintenance-PyTorch repository." } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
    <title>{title} · RUL/PdM Docs</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Sidebar />
    <div id="mobile-backdrop" class="mobile-backdrop"></div>
    <div class="shell">
      <Hud current={current} />
      <main class="content">
        <slot />
      </main>
    </div>
    <CommandPalette />
    <script>
      const toggle = document.getElementById("mobile-nav-toggle");
      const sidebar = document.querySelector(".sidebar");
      const backdrop = document.getElementById("mobile-backdrop");

      function closeNav() {
        sidebar?.classList.remove("open");
        backdrop?.classList.remove("visible");
      }
      function openNav() {
        sidebar?.classList.add("open");
        backdrop?.classList.add("visible");
      }

      toggle?.addEventListener("click", () => {
        sidebar?.classList.contains("open") ? closeNav() : openNav();
      });
      backdrop?.addEventListener("click", closeNav);
      sidebar?.querySelectorAll("a.nav-link").forEach((a) => a.addEventListener("click", closeNav));
    </script>
    <style is:global>
      .shell { margin-left: var(--sidebar-w); position: relative; z-index: 1; min-height: 100vh; }
      .content { max-width: 980px; margin: 0 auto; padding: 48px 40px 96px; }
      .mobile-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 19;
        background: rgba(5, 7, 10, 0.6);
      }
      @media (max-width: 900px) {
        .shell { margin-left: 0; }
        .content { padding: 32px 20px 72px; }
        .mobile-backdrop.visible { display: block; }
      }
    </style>
  </body>
</html>
