---
import { REPO } from "../data/content";
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const items = [
  { href: "", n: "00", label: "Overview" },
  { href: "map/", n: "01", label: "Project map" },
  { href: "pipeline/", n: "02", label: "Data pipeline" },
  { href: "architecture/", n: "03", label: "Model architecture" },
  { href: "training/", n: "04", label: "Training & eval" },
  { href: "results/", n: "05", label: "Results" },
  { href: "structure/", n: "06", label: "Repository" },
];

function isActive(href: string) {
  const full = (base + href).replace(/\/+$/, "/") || "/";
  const cur = path.replace(/\/+$/, "/") || "/";
  return full === cur;
}
---
<aside class="sidebar">
  <a href={base} class="brand">
    <span class="brand-mark" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M3 12h4l2-7 4 14 2-7h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="brand-text">
      <span class="brand-title">RUL / PdM</span>
      <span class="brand-sub mono">C-MAPSS · FD001</span>
    </span>
  </a>

  <button id="palette-trigger" class="palette-trigger" type="button" aria-label="Open search">
    <span>Search docs…</span>
    <span class="kbd mono"><kbd>⌘</kbd><kbd>K</kbd></span>
  </button>

  <nav class="nav">
    <div class="nav-label eyebrow">Systems</div>
    <ul>
      {items.map((item) => (
        <li>
          <a href={base + item.href} class:list={["nav-link", { active: isActive(item.href) }]}>
            <span class="nav-n mono">{item.n}</span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="sidebar-footer">
    <a href={REPO.url} target="_blank" rel="noopener" class="repo-link">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      <span>Source repository</span>
    </a>
    <div class="license-note">No license file — default copyright applies.</div>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    width: var(--sidebar-w);
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line-hair);
    background: rgba(16, 21, 30, 0.6);
    backdrop-filter: blur(6px);
    z-index: 20;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 18px 16px;
    text-decoration: none;
    border-bottom: 1px solid var(--line-hair);
  }
  .brand-mark {
    color: var(--signal-amber);
    display: flex;
    width: 32px; height: 32px;
    align-items: center; justify-content: center;
    border: 1px solid var(--line-hair-bright);
    border-radius: 6px;
    background: var(--bg-panel-raised);
  }
  .brand-text { display: flex; flex-direction: column; gap: 2px; }
  .brand-title { font-weight: 600; font-size: 14px; letter-spacing: 0.01em; }
  .brand-sub { font-size: 10.5px; color: var(--text-dim); letter-spacing: 0.04em; }

  .palette-trigger {
    margin: 14px 16px 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-panel);
    border: 1px solid var(--line-hair);
    color: var(--text-dim);
    border-radius: 5px;
    padding: 8px 10px;
    font-size: 12.5px;
    font-family: var(--font-body);
    cursor: pointer;
    transition: border-color .15s ease;
  }
  .palette-trigger:hover { border-color: var(--line-hair-bright); color: var(--text-primary); }
  .kbd { display: flex; gap: 3px; }
  .kbd kbd {
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--line-hair-bright);
    border-radius: 3px;
    background: var(--bg-panel-raised);
  }

  .nav { padding: 10px 10px; overflow-y: auto; flex: 1; }
  .nav-label { padding: 8px 10px 6px; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 5px;
    text-decoration: none;
    color: var(--text-dim);
    font-size: 13px;
    border-left: 2px solid transparent;
  }
  .nav-link:hover { background: var(--bg-panel); color: var(--text-primary); }
  .nav-link.active {
    color: var(--text-primary);
    background: var(--bg-panel-raised);
    border-left: 2px solid var(--telemetry-cyan);
  }
  .nav-n { font-size: 10.5px; color: var(--text-faint); width: 18px; }
  .nav-link.active .nav-n { color: var(--telemetry-cyan); }

  .sidebar-footer {
    padding: 14px 18px 18px;
    border-top: 1px solid var(--line-hair);
  }
  .repo-link {
    display: flex; align-items: center; gap: 8px;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 12.5px;
  }
  .repo-link:hover { color: var(--telemetry-cyan); }
  .license-note { margin-top: 8px; font-size: 10.5px; color: var(--text-faint); line-height: 1.5; }

  @media (max-width: 900px) {
    .sidebar { transform: translateX(-100%); transition: transform .2s ease; }
    .sidebar.open { transform: translateX(0); }
  }
</style>
